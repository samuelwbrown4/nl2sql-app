            }
        },
        "carriers": {
            "columns": {
                "id": "uuid",
                "name": "varchar",
                "scac": "varchar",
                "address": "varchar"
            }
        },
        "customers": {
            "columns": {
                "id": "uuid",
                "company_id": "uuid",
                "name": "varchar",
                "address": "varchar",
                "city": "varchar",
                "state": "varchar",
                "zip_code": "varchar",
                "country": "varchar"
            },
            "foreign_keys": {
                "company_id": "companies.id"
            }
        },
        "suppliers": {
            "columns": {
                "id": "uuid",
                "company_id": "uuid",
                "name": "varchar",
                "address": "varchar",
                "city": "varchar",
                "state": "varchar",
                "zip_code": "varchar",
                "country": "varchar",
                "latitude": "decimal",
                "longitude": "decimal"
            },
            "foreign_keys": {
                "company_id": "companies.id"
            }
        },
        "customer_locations": {
            "columns": {
                "id": "uuid",
                "customer_id": "uuid",
                "name": "varchar",
                "address": "varchar",
                "city": "varchar",
                "state": "varchar",
                "zip_code": "varchar",
                "country": "varchar",
                "latitude": "decimal",
                "longitude": "decimal"
            },
            "foreign_keys": {
                "customer_id": "customers.id"
            }
        },
        "shipper_locations": {
            "columns": {
                "id": "uuid",
                "company_id": "uuid",
                "erp_id": "varchar",
                "name": "varchar",
                "address": "varchar",
                "city": "varchar",
                "state": "varchar",
                "zip_code": "varchar",
                "country": "varchar",
                "latitude": "decimal",
                "longitude": "decimal"
            },
            "foreign_keys": {
                "company_id": "companies.id"
            }
        },
        "shipper_users": {
            "columns": {
                "id": "uuid",
                "location_id": "uuid",
                "first_name": "varchar",
                "last_name": "varchar",
                "role": "role_enum",
                "newUser": "boolean"
            },
            "excluded_columns": [
                "email",
                "phone_number",
                "password_hash",
                "erp_id"
            ],
            "foreign_keys": {
                "location_id": "shipper_locations.id"
            }
        },
        "carrier_users": {
            "columns": {
                "id": "uuid",
                "carrier_id": "uuid",
                "first_name": "varchar",
                "last_name": "varchar",
                "role": "role_enum",
                "newUser": "boolean"
            },
            "excluded_columns": [
                "email",
                "phone_number",
                "password_hash"
            ],
            "foreign_keys": {
                "carrier_id": "carriers.id"
            }
        },
        "equipment_types": {
            "columns": {
                "id": "uuid",
                "name": "varchar",
                "max_weight": "decimal",
                "mode": "varchar"
            }
        },
        "shipments": {
            "columns": {
                "id": "uuid",
                "company_id": "uuid",
                "direction_category": "direction_enum",
                "shipment_number": "varchar",
                "shipment_type": "shipment_type_enum",
                "bid_deadline": "timestamp",
                "origin_id": "uuid",
                "destination_id": "uuid",
                "carrier_id": "uuid",
                "equipment_type_id": "uuid",
                "status": "shipment_status_enum",
                "total_weight": "decimal",
                "created_at": "timestamp",
                "requested_pickup_date": "date",
                "requested_delivery_date": "date",
                "actual_pickup_date": "date",
                "actual_delivery_date": "date",
                "distance": "decimal",
                "rate": "decimal",
                "planned_by_user_id": "uuid",
                "transit_start_time": "timestamp",
                "route_time_seconds": "decimal",
                "near_destination": "boolean"
            },
            "excluded_columns": [
                "route_geometry",
                "current_position"
            ],
            "foreign_keys": {
                "company_id": "companies.id",
                "carrier_id": "carriers.id",
                "equipment_type_id": "equipment_types.id",
                "planned_by_user_id": "shipper_users.id"
            },
            "conditions": {
                "origin_id": "IF direction_category = 'outbound' THEN join shipper_locations.id. IF direction_category = 'inbound' THEN join suppliers.id.",
                "destination_id": "IF direction_category = 'outbound' THEN join customer_locations.id. IF direction_category = 'inbound' THEN join shipper_locations.id."
            },
            "known_pitfalls": "A common mistake when joining origin_id/destination_id conditionally is applying the direction_category condition to the wrong branch — e.g. joining shipper_locations with 'AND direction_category = inbound' when it should be 'outbound'. Double-check that each JOIN's direction_category condition matches the mapping stated in 'conditions' above before finalizing."
        },
        "spot_bids": {
            "columns": {
                "id": "uuid",
                "shipment_id": "uuid",
                "carrier_id": "uuid",
                "rate": "decimal",
