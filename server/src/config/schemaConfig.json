            ],
            "foreign_keys": {
                "company_id": "companies.id",
                "customer_id": "customers.id",
                "supplier_id": "suppliers.id"
            }
        },
        "shipment_events": {
            "columns": {
                "id": "uuid",
                "shipment_id": "uuid",
